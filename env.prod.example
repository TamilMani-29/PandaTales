########################################
# Production Environment Variables
########################################
# 
# Copy this file to .env.prod and fill in with your production values
# Usage: docker-compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
#

# === PostgreSQL Container (Production) ===
POSTGRES_USER=pandatales_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_123
POSTGRES_DB=pandatales_prod
POSTGRES_PORT=5432

# === Cloudflare R2 Storage (Production) ===
STORAGE_PROVIDER=r2
R2_ENDPOINT=CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_KEY
R2_BUCKET=pandatales
R2_SECURE=true
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# === Application Security (CRITICAL - Use Strong Secrets) ===
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Application Settings ===
APP_ENV=production
DEBUG=false
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# === API Keys ===
OPENAI_API_KEY=sk-your-openai-key-here
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_VERIFY_SSL=true
REPLICATE_API_TOKEN=your_replicate_token_here

# === Service Ports ===
BACKEND_PORT=8000
FRONTEND_PORT=3000

# === Vite Frontend ===
NODE_ENV=production
VITE_API_BASE_URL=/api
