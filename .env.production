# ======================
# PandaTales Environment Variables
# Production Configuration
# ======================
# 
# IMPORTANT: Replace all placeholder values with actual production credentials
# DO NOT commit this file to version control
#

# Application Environment
APP_ENV=production
NODE_ENV=production
DEBUG=false

# Database Configuration
POSTGRES_USER=pandatales_prod
POSTGRES_PASSWORD=pandatales
POSTGRES_DB=pandatales_production
POSTGRES_PORT=5432

# MinIO Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin@123
MINIO_BUCKET=pandatales
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend API Configuration
BACKEND_PORT=8000
SECRET_KEY=CHANGE_ME_STRONG_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG
JWT_SECRET_KEY=your-secure-jwt-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# CORS Configuration
ALLOWED_ORIGINS="*"

# External Services (REQUIRED for production)
# OpenAI
OPENAI_API_KEY=sk-...

# Stripe Payment
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG...
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Panda Tales

# Monitoring (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
