# ======================
# PandaTales Environment Variables
# Example Template
# ======================
# Copy this file to:
# - .env.development for local development
# - .env.production for production deployment
# - .env for docker-compose (uses development values by default)

# Application Environment
APP_ENV=development
NODE_ENV=development
DEBUG=true

# Database Configuration
POSTGRES_USER=pandatales
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=pandatales
POSTGRES_PORT=5432

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=pandatales
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_BASE_URL=http://localhost:9000

# Backend API Configuration
BACKEND_PORT=8000
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
VITE_PROXY_TARGET=http://backend:8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# External Services (Optional)
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_VERIFY_SSL=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@pandatales.com
SMTP_FROM_NAME=Panda Tales
