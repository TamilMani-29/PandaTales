# ======================
# PandaTales Environment Variables
# Development Configuration
# ======================

# Application Environment
APP_ENV=development
NODE_ENV=development
DEBUG=true

# Database Configuration
POSTGRES_USER=pandatales_dev
POSTGRES_PASSWORD=pandatales
POSTGRES_DB=pandatales_dev
POSTGRES_PORT=5432

# Cloudflare R2 Configuration
STORAGE_PROVIDER=r2
R2_ENDPOINT=d5609f2c12471a916a46f49720369726.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=7ea4e878425f4ae7385bc5f1beb3ac9a
R2_SECRET_ACCESS_KEY=5e4b6c573c168ea1904c32c7a1e679999407309d9a7a934965a0d651ade16ae7
R2_BUCKET=pandorapages
R2_SECURE=true
R2_VERIFY_SSL=false
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# Backend API Configuration
BACKEND_PORT=8000
SECRET_KEY=dev_secret_key_at_least_32_characters_long_12345
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_123456789
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
VITE_PROXY_TARGET=http://backend:8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# External Services (Optional - Add your keys here)
# OpenAI
OPENAI_API_KEY=

# Stripe Payment
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay Payment
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay (local SSL workaround)
RAZORPAY_VERIFY_SSL=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@pandatales.com
SMTP_FROM_NAME=Panda Tales
