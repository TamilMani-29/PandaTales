# ======================
# PandaTales Environment Variables
# Development Configuration
# ======================

# Application Environment
APP_ENV=development
NODE_ENV=development
DEBUG=true

# Database Configuration
POSTGRES_USER=pandatales_dev
POSTGRES_PASSWORD=pandatales
POSTGRES_DB=pandatales_dev
POSTGRES_PORT=5432

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=pandatales
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend API Configuration
BACKEND_PORT=8000
SECRET_KEY=dev_secret_key_at_least_32_characters_long_12345
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_123456789
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
VITE_PROXY_TARGET=http://backend:8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# External Services (Optional - Add your keys here)
# OpenAI
OPENAI_API_KEY=

# Stripe Payment
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay Payment
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay (local SSL workaround)
RAZORPAY_VERIFY_SSL=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@pandatales.com
SMTP_FROM_NAME=Panda Tales
